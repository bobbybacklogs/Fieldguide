# Optional direct-lane override. Set these to skip bridge auto-detection and pin
# a provider/model through the ModelHitch library. Leave unset to prefer a
# running bridge.
FIELDGUIDE_PROVIDER=
FIELDGUIDE_MODEL=

# ModelHitch config directory (default: ~/.modelhitch).
MODELHITCH_HOME=

# ModelHitch bridge base URL to probe (default: http://127.0.0.1:$MODELHITCH_PORT).
# Prefer `fieldguide --bridge <url>` for a one-off override.
MODELHITCH_BRIDGE_URL=

# Bridge port used when MODELHITCH_BRIDGE_URL is unset.
MODELHITCH_PORT=3939
